--- !u!114 &1188775444
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1188774811}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1258
  indentLevel: 1
  storyText: "Yeah, that damn beast thought I was dead. *cough* *cough* But I just
    passed out. When I woke up, that\u2019s when the herd of those walkers barged
    in. Lucky for me I found this shotgun, made my way out through the herd, and
    found Dina and Mr. Mascot here. \r\n"
  description: 
  character: {fileID: 658049315}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
  waitForClick: 1
  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 0}
