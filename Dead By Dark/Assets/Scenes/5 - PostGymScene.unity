  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 793
  indentLevel: 0
  storyText: And what?...
  description: 
  character: {fileID: 627634844}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
