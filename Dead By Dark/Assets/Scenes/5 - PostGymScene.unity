  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 1028
  indentLevel: 0
  storyText: Red like a cherry....
  description: 
  character: {fileID: 432104244}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
