--- !u!114 &1188774976
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1188774811}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 799
  indentLevel: 0
  storyText: Oh my god...  Human DNA overlapping canine DNA? Fur patterns similar
    to that of animals from Eastern Europe? Oh my god!..
  description: 
  character: {fileID: 634040414}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
