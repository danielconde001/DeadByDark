  m_Name: 
  m_EditorClassIdentifier: 
  itemId: 735
  indentLevel: 0
  storyText: "Hi professor, can I ask a favor? Would it be possible to have this
    fur sample analyzed at your lab? It\u2019d be crucial to get more details about
    the killer on the loose."
  description: 
  character: {fileID: 627634844}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
